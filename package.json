{
  "name": "manga-voice-studio",
  "version": "1.3.17",
  "private": true,
  "description": "Self-hosted веб-инструмент для автоматической генерации озвученных видео из изображений манги/комиксов",
  "author": "DMloaderJava",
  "main": "electron/main.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "setup": "node scripts/setup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "smoke:tts": "tsx scripts/smoke-tts.ts",
    "smoke:audio": "tsx scripts/smoke-audio.ts",
    "smoke:server": "node scripts/smoke-server.mjs",
    "smoke:editor": "node scripts/smoke-editor.mjs",
    "smoke:onboarding": "node scripts/smoke-onboarding.mjs",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run build && npm run smoke:server",
    "verify:quick": "npm run typecheck && npm run lint && npm run build && npm run smoke:server",
    "desktop": "electron electron/main.js",
    "desktop:dev": "concurrently \"npm run dev -- -H 0.0.0.0 -p 3000\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "desktop:build": "next build && electron-builder",
    "desktop:pack": "next build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.48.0",
    "mediabunny": "^1.61.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^8.2.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.mangavoice.studio",
    "productName": "Manga Voice Studio",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      "next.config.ts"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  }
}
