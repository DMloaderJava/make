# Server-only Supabase credentials. Never use NEXT_PUBLIC_ for these values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Backward-compatible fallback; prefer SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_KEY=your-server-side-supabase-key

# Protects the existing application login.
MVS_PASSWORD=change-me
MVS_SECURE_COOKIE=1

# Optional protection for the Vercel cleanup endpoint.
CRON_SECRET=change-me-too
